# Export variables or pass this file to the container runtime.
WUALT_MODEL_URL=http://127.0.0.1:8081
WUALT_DATA_DIR=./outputs
# Both modes disable fallback. guarded rejects flagged output; raw_review retains it for review.
WUALT_REPORT_MODE=guarded
# WUALT_MODEL_API_KEY=your-local-model-service-key
# WUALT_API_KEY=your-report-api-key
# WUALT_SOURCE_DB=/path/to/incidents.sqlite3
# WUALT_SOURCE_API_BASE=https://your-backend.example/api
# WUALT_SOURCE_API_TOKEN=your-server-token
# WUALT_ALLOWED_ORIGINS=https://your-report-ui.example
