# Export variables or pass this file to the container runtime.
# Must match the model port (deploy/start-model.sh reads WUALT_MODEL_PORT, default 8081; RunPod uses 8081 itself, so use 18083 there).
WUALT_MODEL_URL=http://127.0.0.1:8081
# WUALT_MODEL_API_KEY=your-local-model-service-key
# WUALT_API_KEY=your-interpretation-api-key
# WUALT_ALLOWED_ORIGINS=https://your-ui.example
