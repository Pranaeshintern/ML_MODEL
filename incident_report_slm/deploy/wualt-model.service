[Unit]
Description=WUALT Qwen3-14B llama.cpp model service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wualt
Group=wualt
WorkingDirectory=/opt/wualt/source/incident_report_slm
Environment=WUALT_RUNTIME_DIR=/var/lib/wualt
# Optional: WUALT_MODEL_PORT=<port> when 8081 is taken (see DEPLOYMENT.md step 5).
EnvironmentFile=-/etc/wualt/model.env
ExecStart=/bin/bash /opt/wualt/source/incident_report_slm/deploy/start-model.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
